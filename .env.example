# Discord bot token (required)
DISCORD_TOKEN=

# Audio device name substring to match (default: Blackstar)
AUDIO_DEVICE=Blackstar

# Audio backend: sounddevice or ffmpeg (default: sounddevice)
AUDIO_BACKEND=sounddevice

# Playback volume multiplier (default: 1.0)
VOLUME=1.0

# Log selected backend/device/volume without exposing secrets
DEBUG_CONFIG=false
