# Discord bot token (required)
DISCORD_TOKEN=

# Optional: the one Discord user (numeric ID) allowed to run commands.
# Left unset, the owner of this bot's Discord application is authorized.
# OWNER_ID=

# Optional: register commands in one server only (numeric server ID).
# Left unset, commands are available in every server the bot joins.
# GUILD_ID=

# Audio device name to match (required): an exact name, or a substring that
# names one device. guitar-amp-bot-setup lists your inputs and fills this in.
AUDIO_DEVICE=Blackstar

# Device inputs to stream, numbered from 1: "1,2" for stereo (default), one
# input such as "1" for mono in both ears, or a pair such as "3,4".
# INPUT_CHANNELS=1,2

# Audio backend: sounddevice or ffmpeg (default: sounddevice)
AUDIO_BACKEND=sounddevice

# Playback volume multiplier (default: 1.0)
VOLUME=1.0

# Log selected backend/device/volume without exposing secrets
DEBUG_CONFIG=false

# Rotating audit log file; leave empty to log to stderr only
LOG_FILE=guitar-amp-bot.log

# Log verbosity: DEBUG, INFO (default), WARNING or ERROR
# LOG_LEVEL=INFO
